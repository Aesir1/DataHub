# Copy to .env (git-ignored) and change every secret. Read by compose.prod.yaml and compose.observability.yaml.
# The values below are for a local test on this machine; the comments say what changes on a server.

# --- public names -------------------------------------------------------------------------------
# Local: *.localhost resolves to 127.0.0.1 without any hosts entry.
# Server: real names that resolve to the server (Caddy's ACME challenge needs them before the first `up`).
APP_DOMAIN=app.datahub.localhost
AUTH_DOMAIN=auth.datahub.localhost
HOOKS_DOMAIN=hooks.datahub.localhost

# Local: `internal` (Caddy's own CA; trust it once, see README). Server: the ACME e-mail address.
CADDY_TLS=internal
# Local only, with CADDY_TLS=internal: lets the web server trust Caddy's CA for its OIDC calls.
# Server: leave empty.
WEB_EXTRA_CA_CERTS=/ca/root.crt
DEPLOYMENT_ENVIRONMENT=local
# Host ports. 80 answers plain http:// with a redirect to https:// (and serves the ACME challenge on a
# server); 443 must stay, the public URLs have no port. Move 80 only if something else must keep it.
# Server (server-provision): 0.0.0.0:80 / 0.0.0.0:443, because dockerd binds unaddressed ports to 127.0.0.1.
HTTP_PORT=80
HTTPS_PORT=443

# Images. Local: `docker compose -f compose.prod.yaml build`. Server: your registry and a commit SHA.
IMAGE_REPO=datahub
IMAGE_TAG=local

# --- PostgreSQL -----------------------------------------------------------------------------------
# Owner of the app and auth databases; DbUtils migrates with it.
POSTGRES_USER=datahub
POSTGRES_PASSWORD=change-me-owner
# Runtime role of the api: SELECT/INSERT/UPDATE/DELETE only.
APP_DB_USER=datahub_app
APP_DB_PASSWORD=change-me-app
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
# Read-only pg_monitor role for postgres-exporter.
PG_EXPORTER_USER=datahub_metrics
PG_EXPORTER_PASSWORD=change-me-metrics

# --- Keycloak -------------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Admin console over the tunnel: ssh -L 8081:localhost:8081 <server>, then open KEYCLOAK_ADMIN_URL.
KEYCLOAK_ADMIN_BIND=127.0.0.1:8081
KEYCLOAK_ADMIN_URL=http://localhost:8081
WEB_CLIENT_SECRET=change-me-web-client-secret
WEBHOOK_CLIENT_SECRET=change-me-webhook-client-secret

# --- web ------------------------------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret-at-least-32-characters

# --- webhook --------------------------------------------------------------------------------------
WEBHOOK_HMAC_SECRET=change-me-hmac-secret
# During a secret rotation: the previous secret, accepted until senders switched.
WEBHOOK_HMAC_SECRET_PREVIOUS=

# --- RabbitMQ -------------------------------------------------------------------------------------
RABBITMQ_USER=datahub
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- MinIO ----------------------------------------------------------------------------------------
# Root credentials administer MinIO; the services never use them.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root
# Scoped accounts created by minio-init: api (documents, branding), webhook (webhooks).
API_S3_ACCESS_KEY=datahub-api
API_S3_SECRET_KEY=change-me-api-s3-secret
WEBHOOK_S3_ACCESS_KEY=datahub-webhook
WEBHOOK_S3_SECRET_KEY=change-me-webhook-s3-secret

# --- observability --------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Loopback only. Server: ssh -L 3300:localhost:3300 <server>
GRAFANA_BIND=127.0.0.1:3300
GRAFANA_ROOT_URL=http://localhost:3300
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=2GB
