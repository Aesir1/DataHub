# Public entrypoint. Caddy terminates TLS for every host below and proxies over the internal `proxy`
# network. CADDY_TLS is an ACME e-mail in production (Let's Encrypt; the names must resolve to this
# host and ports 80/443 must be reachable) and `internal` for local testing (Caddy's own CA).
{
	admin off
}

(common) {
	tls {$CADDY_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		-X-Powered-By
	}
}

# Next.js front end and its backend-for-frontend routes (/api/graphql, /api/documents/*, /api/branding/*).
# The Api and MinIO are not public: document bytes go browser -> web -> api -> MinIO.
{$APP_DOMAIN} {
	import common
	header X-Frame-Options DENY
	# Documents are at most 25 MB; the api enforces that too.
	request_body {
		max_size 26MB
	}
	reverse_proxy web:3000
}

# Keycloak: login, registration and the OIDC endpoints of the datahub realm. The admin console and
# the master realm (admin logins, admin tokens) are not published; reach them over a tunnel
# (KEYCLOAK_ADMIN_BIND in .env). The services talk to Keycloak internally, not through Caddy.
{$AUTH_DOMAIN} {
	import common
	# The tunnelled admin console loads its third-party-cookie check and session iframe from the
	# master realm's PUBLIC frontend URL; these are static helper pages without auth data, so they
	# are exempt from the master-realm block below (else the console dies with "Timeout when
	# waiting for 3rd party check iframe").
	@consoleIframes path /realms/master/protocol/openid-connect/3p-cookies/* /realms/master/protocol/openid-connect/login-status-iframe.html
	handle @consoleIframes {
		reverse_proxy keycloak:8080
	}
	@admin path /admin /admin/* /realms/master /realms/master/*
	handle @admin {
		respond 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}

# Inbound webhooks (Azure Functions). Only the webhook route and the health probe exist publicly.
{$HOOKS_DOMAIN} {
	import common
	@allowed path /api/webhooks/* /api/health
	handle @allowed {
		reverse_proxy webhook:80
	}
	respond 404
}
