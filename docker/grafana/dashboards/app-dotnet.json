{
  "uid": "app-dotnet",
  "title": "DataHub .NET services",
  "description": "ASP.NET Core request, runtime and error metrics of the DataHub .NET services, with the path down into traces and logs.",
  "tags": [
    "datahub",
    "application"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api,webhook,dbutils-migrate",
        "current": {
          "text": "api",
          "value": "api"
        },
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "api",
            "value": "api",
            "selected": true
          },
          {
            "text": "webhook",
            "value": "webhook",
            "selected": false
          },
          {
            "text": "dbutils-migrate",
            "value": "dbutils-migrate",
            "selected": false
          }
        ]
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": "trace,debug,info,warn,error,critical,fatal",
        "options": [],
        "refresh": 0
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"datahub/$service\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
