{
  "uid": "app-overview",
  "title": "Application Overview",
  "description": "Everything the DataHub AppHost runs at a glance: is it up, and what is it using.",
  "tags": [
    "datahub",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Api · Webhook · Web",
      "type": "link",
      "url": "/d/app-dotnet",
      "icon": "external link"
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgres",
      "icon": "external link"
    },
    {
      "title": "MinIO",
      "type": "link",
      "url": "/d/minio",
      "icon": "external link"
    },
    {
      "title": "Containers",
      "type": "link",
      "url": "/d/containers",
      "icon": "external link"
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/logs",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Api · Webhook · Web",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(probe_success{job=\"blackbox\",instance=~\"api|webhook|web\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "HTTP probe of /health, run every 30s by Alloy."
    },
    {
