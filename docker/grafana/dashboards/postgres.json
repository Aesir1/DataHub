    {
      "type": "table",
      "title": "Slowest queries (mean seconds per call, by query id)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, rate(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range]) / clamp_min(rate(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range]), 0.0001))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Mean seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calls / sec"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Mean seconds",
            "desc": true
          }
        ]
      },
      "description": "pg_stat_statements stores query *shapes* — the literals are stripped, so no member data reaches the metrics. Resolve a queryid with:  SELECT query FROM pg_stat_statements WHERE queryid = <id>;",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "queryid",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "datname 2": true,
              "user 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true
            },
            "renameByName": {
              "queryid": "Query id",
              "datname": "Database",
              "datname 1": "Database",
              "user": "Role",
              "user 1": "Role",
              "Value #A": "Mean seconds",
              "Value #B": "Calls / sec"
            }
          }
        }
      ]
    },
